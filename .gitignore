/target
**/.structurizr/

# Obsidian: commit shared settings, ignore per-user state
docs/.obsidian/workspace*.json
docs/.obsidian/cache
docs/.obsidian/plugins/
docs/.obsidian/community-plugins.json
docs/.trash/

# Personal agent settings (model, endpoint, permissions); never committed
.claude/settings.local.json
.claude/*.local.*
