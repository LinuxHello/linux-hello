# AppArmor profile of the Linux Hello Agent. Install as /etc/apparmor.d/linuxhello-agent and
# load in enforce mode; the systemd unit refuses to start otherwise (AGENTS.md invariant 3).
# It grants: the system bus, the TPM resource manager, its state directory and the read-only
# admin policy. It grants no network, no capability, no ptrace and no access to home directories.
abi <abi/4.0>,

include <tunables/global>

profile linuxhello-agent /usr/libexec/linuxhello/linuxhello-agent flags=(attach_disconnected) {
  include <abstractions/base>

  # The binary itself.
  /usr/libexec/linuxhello/linuxhello-agent mr,

  # The system bus, over a unix socket only, and the name of ADR-0012.
  network unix stream,
  # The watchdog: one datagram to the service manager's notification socket (linuxhello-agent
  # notify.rs); nothing else uses a datagram socket.
  network unix dgram,
  /run/systemd/notify w,
  /run/dbus/system_bus_socket rw,
  dbus bind bus=system name=io.github.LinuxHello.Agent1,
  dbus (send, receive) bus=system path=/io/github/LinuxHello/Agent1
       interface=io.github.LinuxHello.Agent1,
  dbus (send, receive) bus=system path=/io/github/LinuxHello/Agent1
       interface=org.freedesktop.DBus.{Introspectable,Peer},
  dbus send bus=system path=/org/freedesktop/DBus interface=org.freedesktop.DBus
       member={Hello,RequestName,ReleaseName,GetConnectionCredentials,AddMatch,RemoveMatch,GetNameOwner,StartServiceByName}
       peer=(name=org.freedesktop.DBus),
  # The bus tells the Agent when a connection leaves, so that the prompts it opened and its
  # subscriptions are removed (NameOwnerChanged, from the bus itself and nothing else).
  dbus receive bus=system path=/org/freedesktop/DBus interface=org.freedesktop.DBus
       member=NameOwnerChanged
       peer=(name=org.freedesktop.DBus),

  # The fingerprint method (ADR-0023): the Agent is a client of fprintd. It calls the manager and
  # the readers, hears the result of a scan, and reads the account name of the user who signs in
  # (a name that only a name service knows is not found, and that user has no fingerprint method).
  dbus send bus=system path=/net/reactivated/Fprint/**
       interface=net.reactivated.Fprint.{Manager,Device}
       peer=(name=net.reactivated.Fprint),
  dbus receive bus=system path=/net/reactivated/Fprint/**
       interface=net.reactivated.Fprint.Device member=VerifyStatus
       peer=(name=net.reactivated.Fprint),
  /etc/passwd r,

  # The face method (ADR-0023): Howdy runs as a child of the Agent, started by the Agent's own
  # code with a fixed command line and an empty environment. The Agent may start the Python
  # interpreter and nothing else, and the child INHERITS this profile (ix). A child profile of its
  # own would be narrower (no bus, no TPM), but the unit sets NoNewPrivileges, and the kernel then
  # refuses to enter it ("no new privs", found in the test VM). Isolating Howdy better is a
  # follow-up (a helper unit with its own profile, #195); until then Howdy's files and the camera
  # are listed here, and the denials below still hold for the child: no network, no capability, no
  # tracing, no home directory.
  /usr/bin/python3{,.[0-9]*} ix,
  include <abstractions/python>
  /{usr/,}lib/security/howdy/ r,
  /{usr/,}lib/security/howdy/** mr,
  /etc/nsswitch.conf r,
  /etc/howdy/ r,
  /etc/howdy/** r,
  /dev/video[0-9]* rw,
  /sys/class/video4linux/ r,
  /sys/class/video4linux/** r,
  /sys/devices/** r,

  # The only device: the TPM resource manager.
  /dev/tpmrm0 rw,

  # State: root-key blobs and prompt data.
  /var/lib/linuxhello/ rw,
  /var/lib/linuxhello/** rwk,

  # The PIN socket (ADR-0021): the runtime directory the unit creates, and a stream socket file in
  # it. Writing covers making the socket file; the unix stream rule above covers
  # listening, accepting and reading the peer's credentials (SO_PEERCRED).
  /run/linuxhello/ rw,
  /run/linuxhello/pin.sock rw,

  # The admin policy layer, read-only.
  /etc/linuxhello/policy.d/ r,
  /etc/linuxhello/policy.d/** r,

  # No tracing of or by the Agent, and no reading of other processes' memory.
  deny ptrace,
  deny @{PROC}/*/mem rw,
  deny @{PROC}/kcore r,

  # No network but the unix socket above, and no capability.
  deny network inet,
  deny network inet6,
  deny capability,

  # No home directories.
  deny /home/** rwklx,
  deny /root/** rwklx,
}
