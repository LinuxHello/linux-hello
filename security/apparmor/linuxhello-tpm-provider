# AppArmor profile of the Linux Hello TPM provider. Install as
# /etc/apparmor.d/linuxhello-tpm-provider and load in enforce mode; the systemd unit refuses to start
# otherwise (AGENTS.md invariant 3). It grants: the TPM resource manager, its own socket, the TSS2
# libraries, /etc/passwd to find the Agent's user, and systemd's notification socket for its watchdog. It grants no network, no capability, no ptrace,
# no bus and no access to home directories or to the Agent's state.
abi <abi/4.0>,

include <tunables/global>

profile linuxhello-tpm-provider /usr/libexec/linuxhello/linuxhello-tpm-provider flags=(attach_disconnected) {
  include <abstractions/base>

  # The binary itself, and the TSS2 libraries it links and loads (the device TCTI is loaded when the
  # connection is opened).
  /usr/libexec/linuxhello/linuxhello-tpm-provider mr,
  /{usr/,}lib/x86_64-linux-gnu/libtss2-*.so* mr,
  /etc/tpm2-tss/** r,

  # The only device: the TPM resource manager.
  /dev/tpmrm0 rw,

  # Its socket, and the directory the unit makes for it. The unix stream rule covers listening,
  # accepting and reading the peer's credentials.
  network unix stream,
  /run/linuxhello-tpm/ rw,
  /run/linuxhello-tpm/tpm.sock rw,

  # The watchdog: one datagram to the service manager's notification socket (`linuxhello-dbus`
  # notify.rs, sent from the provider's main.rs); nothing else uses a datagram socket. A unit line alone would not be enough.
  network unix dgram,
  /run/systemd/notify w,

  # Found in the test VM: something in the TSS2 stack's start-up reads the process's own cgroup.
  owner @{PROC}/@{pid}/cgroup r,
  # And Rust's standard library asks the cgroup how many CPUs it may use.
  /sys/fs/cgroup/ r,
  /sys/fs/cgroup/**/cpu.max r,

  # The Agent's account, to find the one user it serves.
  /etc/passwd r,

  # No tracing of or by the provider, and no reading of other processes' memory.
  deny ptrace,
  deny @{PROC}/*/mem rw,
  deny @{PROC}/kcore r,

  # No network but the unix socket above, and no capability.
  deny network inet,
  deny network inet6,
  deny capability,

  # No home directories, and nothing of the Agent's state.
  deny /home/** rwklx,
  deny /root/** rwklx,
  deny /var/lib/linuxhello/** rwklx,
}
