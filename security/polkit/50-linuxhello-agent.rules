// Lets the Linux Hello Agent use the fingerprint service for the person who is signing in.
//
// fprintd asks polkit before it lets a program claim a fingerprint reader for a user and scan a
// finger. The Agent runs as its own user (linuxhello), not as the person signing in, so without
// this rule fprintd would refuse it. The rule allows that one user exactly three actions: claiming
// a reader for another account and scanning, for signing in, and enrolling, which fprintd also
// checks for deleting a finger. The Agent enrols and deletes only for the person who asks it on
// the bus, and enrols only after that person's PIN (ADR-0027). Nothing else is allowed.
// Install as /etc/polkit-1/rules.d/50-linuxhello-agent.rules.
polkit.addRule(function(action, subject) {
    if (subject.user == "linuxhello" &&
        (action.id == "net.reactivated.fprint.device.verify" ||
         action.id == "net.reactivated.fprint.device.setusername" ||
         action.id == "net.reactivated.fprint.device.enroll")) {
        return polkit.Result.YES;
    }
});
