# The Linux Hello Agent as a system service (ADR-0014). Install as
# /usr/lib/systemd/system/linuxhello-agent.service. Fails closed: the unit does not start
# unless its AppArmor profile is loaded in enforce mode (AGENTS.md invariant 3).
[Unit]
Description=Linux Hello Agent
Documentation=https://github.com/LinuxHello/linux-hello
Requires=dbus.socket
After=dbus.socket
Before=display-manager.service
StartLimitIntervalSec=0

[Service]
Type=dbus
BusName=io.github.LinuxHello.Agent1
# "+" runs this check with full privileges: reading the profile list needs root.
ExecStartPre=+/bin/sh -c 'grep -qx "linuxhello-agent (enforce)" /sys/kernel/security/apparmor/profiles'
ExecStart=/usr/libexec/linuxhello/linuxhello-agent
AppArmorProfile=linuxhello-agent
User=linuxhello
Group=linuxhello
Restart=on-failure
# A fault that never goes away (a profile that is not enforced, a TPM with an owner password) must
# not restart the service every second for ever: the pause grows from one second to a minute in
# five steps (systemd 254 or newer; review finding R-29, #371).
RestartSec=1
RestartSteps=5
RestartMaxDelaySec=60
# The Agent pings the service manager from its bus loop (`linuxhello-dbus` notify.rs). A loop that hangs stops the
# pings and the unit is restarted. Only the main process may notify, and the profile allows the
# notification socket, so a unit line alone would not be enough (#191).
WatchdogSec=30s
NotifyAccess=main

# State: root-key blobs and prompt data live under /var/lib/linuxhello, mode 0700.
StateDirectory=linuxhello
StateDirectoryMode=0700
# /run/linuxhello holds the PIN socket (ADR-0021). The directory is the Agent's and nobody else can
# change it; every user may enter it, because a PAM module runs as whoever signs in.
RuntimeDirectory=linuxhello
RuntimeDirectoryMode=0755
UMask=0077
# The admin policy layer is read-only for the Agent.
ReadOnlyPaths=/etc/linuxhello

# Sandbox. There is no device and no network but the system bus. The Agent reaches the TPM only
# through the provider's socket and never opens the TPM device (R-09, #351).
NoNewPrivileges=yes
# No core dump of a process that holds a PIN or a stretched key: a core file would write it to disk.
# The Agent also marks itself not dumpable when it starts (PR_SET_DUMPABLE), which keeps other
# processes of its user from reading its memory too.
LimitCORE=0
# A flood of calls must not exhaust the machine. The memory covers Howdy, a Python child that loads
# face models; the tasks cover its threads.
MemoryMax=1G
# Nothing of the Agent goes to swap: it holds PIN material while it stretches a PIN.
MemorySwapMax=0
TasksMax=128
LimitNOFILE=1024
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
IPAddressDeny=any
RemoveIPC=yes
PrivateIPC=yes
KeyringMode=private
SocketBindDeny=any
# Not RestrictFileSystems=: it needs the BPF security module, which Ubuntu does not enable, and
# without it systemd refuses to start the unit at all (seen on Ubuntu 26.04: status 244/BPF).
RestrictAddressFamilies=AF_UNIX
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
